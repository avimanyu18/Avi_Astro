{
    "name": "vedic-astrology-frontend",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "Online Vedic astrology desktop application",
    "author": "Avimanyu Astro AI",
    "main": "electron-main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "desktop:dev": "npm run build && electron .",
        "desktop:build": "npm run build && electron-builder --win nsis",
        "test:e2e": "playwright test",
        "android:add": "npx cap add android",
        "android:copy": "npx cap copy android",
        "android:open": "npx cap open android",
        "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
        "android:sync": "npx cap sync android"
    },
    "dependencies": {
        "@capacitor/core": "^6.0.0",
        "@capacitor/android": "^6.0.0",
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "build": {
        "appId": "com.avimanyu.astro.ai.desktop",
        "productName": "Avimanyu Astro AI",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron-main.cjs",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "signAndEditExecutable": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "devDependencies": {
        "@capacitor/cli": "^6.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3",
        "autoprefixer": "^10.4.14",
        "postcss": "^8.4.24",
        "tailwindcss": "^3.4.0",
        "vite": "^5.1.2",
        "vite-plugin-pwa": "^0.20.0",
        "playwright": "^1.41.0",
        "typescript": "^5.0.0"
    }
}